# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# NEVER commit your actual .env file to Git!

OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key

# Optional: which OpenRouter model Tailor uses (default: anthropic/claude-sonnet-5.5)
# OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# PostHog analytics for the local app (public project key, starts with phc_).
# Leave POSTHOG_KEY empty to turn analytics off.
POSTHOG_KEY=phc_replace-with-your-project-key
POSTHOG_HOST=https://us.i.posthog.com

# Optional: abuse/cost limits for the AI route (defaults shown)
# RATE_LIMIT_PER_HOUR=5     # per visitor (IP)
# DAILY_RUN_CAP=100         # whole site, AI runs per day (~$5 at ~$0.05/run)
